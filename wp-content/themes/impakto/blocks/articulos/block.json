{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "impakto/articulos",
	"title": "Artículos recientes",
	"category": "impakto",
	"description": "Últimos artículos del blog en tarjetas.",
	"textdomain": "impakto",
	"attributes": { "cantidad": { "type": "number", "default": 3 }, "categoria": { "type": "string", "default": "" } },
	"supports": { "html": false, "className": true },
	"editorScript": "impakto-bloques-editor",
	"render": "file:./render.php",
	"impakto": { "etiquetas": { "cantidad": "Cantidad", "categoria": "Categoría (slug, opcional)" } }
}
