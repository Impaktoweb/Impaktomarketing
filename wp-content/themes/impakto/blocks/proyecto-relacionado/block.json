{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "impakto/proyecto-relacionado",
	"title": "Proyecto relacionado",
	"category": "impakto",
	"description": "Tarjeta de un proyecto del portafolio (por su slug), para citar un caso dentro de un artículo.",
	"textdomain": "impakto",
	"attributes": { "slug": { "type": "string", "default": "" } },
	"supports": { "html": false, "className": true },
	"editorScript": "impakto-bloques-editor",
	"render": "file:./render.php",
	"impakto": { "etiquetas": { "slug": "Slug del proyecto (p. ej. constructora-hungria-ventas-digitales)" } }
}
