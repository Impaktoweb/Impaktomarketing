{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "impakto/servicios",
	"title": "Tarjetas de servicios",
	"category": "impakto",
	"description": "Franja de servicios: carrusel en móvil, cuadrícula en escritorio. Lee el tipo de contenido Servicio.",
	"textdomain": "impakto",
	"attributes": {
		"bloque": {
			"type": "string",
			"default": ""
		},
		"cantidad": {
			"type": "number",
			"default": 8
		},
		"ids": {
			"type": "string",
			"default": ""
		},
		"manual": {
			"type": "string",
			"default": ""
		},
		"whatsapp": {
			"type": "boolean",
			"default": false
		}
	},
	"supports": {
		"html": false,
		"className": true
	},
	"editorScript": "impakto-bloques-editor",
	"render": "file:./render.php",
	"impakto": {
		"etiquetas": {
			"bloque": "Bloque del proceso (vacío = todos)",
			"cantidad": "Cantidad máxima",
			"ids": "Ids de servicios en orden (opcional, separados por coma)",
			"manual": "Tarjetas manuales (una por línea: Título | Texto | URL). Si se llena, reemplaza la consulta.",
			"whatsapp": "Botón de WhatsApp en cada tarjeta"
		},
		"opciones": {
			"bloque": {
				"": "Todos",
				"investigacion-marca": "Investigación y marca",
				"contenido-produccion": "Contenido y producción",
				"marketing-digital": "Marketing digital",
				"ventas": "Ventas"
			}
		},
		"multilinea": [
			"manual"
		]
	}
}