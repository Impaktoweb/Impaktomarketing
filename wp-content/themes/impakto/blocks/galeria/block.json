{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "impakto/galeria",
	"title": "Galería",
	"category": "impakto",
	"description": "Galería con lightbox. Mientras llegan las fotos reales muestra marcadores con la proporción correcta.",
	"textdomain": "impakto",
	"attributes": { "ids": { "type": "string", "default": "" }, "marcadores": { "type": "number", "default": 8 }, "etiqueta": { "type": "string", "default": "Foto del espacio" } },
	"supports": { "html": false, "className": true },
	"editorScript": "impakto-bloques-editor",
	"render": "file:./render.php",
	"impakto": { "etiquetas": { "ids": "Ids de imágenes de la biblioteca (separados por coma)", "marcadores": "Marcadores mientras no hay fotos", "etiqueta": "Texto del marcador" } }
}
